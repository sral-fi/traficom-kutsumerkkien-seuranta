DB_HOST=localhost
DB_PORT=3306
DB_NAME=traficom_tracker
DB_USER=traficom
DB_PASSWORD=changeme

# Allowed CORS origins for the React frontend (comma-separated).
# Set to your production domain, e.g. https://oh-kutsumerkit.oh2lak.radio
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Site base URL (also added to the CORS allowlist).
SITE_BASEURL=

# Show full exception details in HTTP responses.
# Set true ONLY in development – never in production.
DISPLAY_ERROR_DETAILS=false

# Logging level: debug | info | warning | error  (default: warning)
LOG_LEVEL=warning

# Set to 'production' on HTTPS servers.
APP_ENV=development

# Slim base path (leave empty unless API is mounted at a sub-path).
SLIM_BASE_PATH=
